---
export const prerender = false
import NoFooter from '@layouts/NoFooter.astro';
import CfaApply from '@components/CfaApply/index.astro';
import { fetchBcnCfa } from '@data/fetchers';
import type { PageData } from '@data/types';
import { fetchSettings, type SettingsData } from '@data/settings';
import Meta from '@components/Meta/Meta.astro';

const draftMode = Astro.locals.draftMode ?? false
const settings: SettingsData = await fetchSettings();
const cfa: PageData = await fetchBcnCfa(draftMode);
---

<NoFooter showNav={false} namespace="2026/barcelona">
  <Meta
    title="Submit an abstract"
    settings={settings}
    imgUrl={cfa?.seo?.shareImage?.asset?.url}
  />
  <CfaApply
    location="barcelona"
    formUrl={cfa?.swoogoUrl}
    backUrl="/2026/barcelona/call-for-abstracts/"
  />
</NoFooter>
