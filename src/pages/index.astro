---
// 2027 holding page. Copy lives in code (not the Sanity `homepage` doc) until the
// 2027 site is built out — see src/data/site.ts.
import Layout from '@layouts/Base.astro';
import LandingHero from '@components/LandingHero';
import { fetchSettings, type SettingsData } from '../data/settings';
import Meta from '../components/Meta/Meta.astro';
import { SUMMIT_YEAR, CFA_PATH } from '@data/site';
import { textBlocks } from '@utils/textBlocks';

const settings: SettingsData = await fetchSettings();

const content = textBlocks(
  'Nextflow Summit, presented by Seqera, brings together scientists from around the world to shape the future of biotech R&D through community-driven innovation in data science and computational biology.',
  `Nextflow Summit ${SUMMIT_YEAR} is coming to Boston. The call for abstracts is now open: share your work with the Nextflow community.`,
);
---

<Layout>
  <Meta title="Home" settings={settings} />
  <LandingHero
    isHome
    title={`Nextflow Summit ${SUMMIT_YEAR}`}
    content={content}
    headlineSize="xl"
    ctaText1="Submit an abstract"
    ctaLink1={CFA_PATH}
    ctaText2="Past events"
    ctaLink2="/past-events"
    client:load
  />
</Layout>
