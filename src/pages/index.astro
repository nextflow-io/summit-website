---
// 2027 holding page. Copy lives in code (not the Sanity `homepage` doc) until the
// 2027 site is built out — see src/data/site.ts.
import Layout from '@layouts/Base.astro';
import LandingHero from '@components/LandingHero';
import { fetchSettings, type SettingsData } from '../data/settings';
import Meta from '../components/Meta/Meta.astro';
import { CFA_PATH } from '@data/site';
import { textBlocks } from '@utils/textBlocks';

const settings: SettingsData = await fetchSettings();

// Copy taken from marketing's 2027 landing-page doc (see the CFA page).
const content = textBlocks(
  'Nextflow Summit Boston · April 29–30, 2027',
  'Nextflow Summit brings together the scientists, bioinformaticians, engineers, and leaders who turn biological data into discoveries. Join us in Boston for two days of talks, posters and networking.',
  'Call for Abstracts for Talks and Posters are Now Open. Submit your abstract by Friday, February 5, 2027.',
);
---

<Layout>
  <Meta title="Home" settings={settings} />
  <LandingHero
    isHome
    title="Nextflow Summit"
    content={content}
    headlineSize="xl"
    ctaText1="Submit an abstract"
    ctaLink1={CFA_PATH}
    ctaText2="Past events"
    ctaLink2="/past-events"
    client:load
  />
</Layout>
