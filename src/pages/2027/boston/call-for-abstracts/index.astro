---
// 2027 Call for Abstracts, built in code (no Sanity) until the 2027 rebrand.
// Copy is from marketing's landing-page doc
// ("FY26Q4 - [Landing Page] Nextflow Summit Boston 2027", 2027 Copy tab).
//
// Flow: hero + key facts -> about + topic ideas -> Talks / Posters formats
// (what you need to know before starting) -> the form, framed in its own band.
import Layout from '@layouts/Base.astro';
import Meta from '@components/Meta/Meta.astro';
import Button from '@components/Button';
import TypeformEmbed from '@components/TypeformEmbed';
import FeatureBlocks from '@modules/FeatureBlocks';
import { SUMMIT_YEAR, CFA_TYPEFORM_ID } from '@data/site';
import { PAST_EVENTS } from '@data/pastEvents';

const typeformUrl = `https://seqera.typeform.com/to/${CFA_TYPEFORM_ID}`;

const facts = [
  ['Deadline', 'Friday, February 5, 2027'],
  ['Event', 'April 29–30, 2027 · Boston'],
  ['Formats', 'Talks and posters'],
];

const topics = [
  'Real-world applications of Nextflow',
  'Lessons learned from pipeline development',
  'Building with and contributing to nf-core',
  'Bio/ML and foundation models in practice',
  'Regulatory genomics and single-cell models',
  'Protein and molecular design',
  'AI across drug discovery and development',
  'Agents and autonomous science',
  'Connecting the wet lab and the dry lab',
  'Clinical genomics and diagnostics',
  'Data, GPUs and compute at scale',
];

// Talks / Posters cards: FeatureBlocks + Box (white section, green cards), the
// same pattern as the other pages. Labels in bold via Portable Text marks.
const line = (label: string, value: string, i: number) => ({
  _type: 'block',
  _key: `l${i}`,
  style: 'normal',
  markDefs: [],
  children: [
    { _type: 'span', _key: `l${i}a`, marks: ['strong'], text: `${label}: ` },
    { _type: 'span', _key: `l${i}b`, marks: [], text: value },
  ],
});
const card = (title: string, rows: [string, string][]) => ({
  title,
  boxStyle: 'green',
  bodycopy: rows.map(([label, value], i) => line(label, value, i)),
});
const formats = [
  card('Talks', [
    ['Format', 'In-person talk on stage'],
    ['Length', '30 minutes, including Q&A'],
    ['Abstract', 'Up to 250 words, plus a title, speaker bio, and author list.'],
    ['Perks', 'Free event registration for selected speakers'],
  ]),
  card('Posters', [
    ['Format', 'In-person poster session and lightning talk on stage'],
    ['Length', '2 min lightning talks followed by a poster session'],
    ['Abstract', 'Up to 250 words, plus a title, speaker bio, and author list.'],
    ['Perks', 'Free event registration for poster presenters.'],
  ]),
];
---

<Layout>
  <Meta
    title={`Call for Abstracts | Boston ${SUMMIT_YEAR}`}
    description="Whether you're running Nextflow at scale, designing proteins, training models or building agents, we want to hear how your work is moving discovery and development forward."
    imgUrl={PAST_EVENTS[0].image.replace('w=900&h=675', 'w=1200&h=630')}
  />

  {/* Hero: headline on the left, key facts on the right */}
  <section class="container-xl pt-16 md:pt-24 pb-16 md:pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-16 gap-y-10 items-end">
      <div class="lg:col-span-7">
        <p class="monospace uppercase text-xs mb-6 text-nextflow">
          Nextflow Summit Boston · April 29–30, 2027
        </p>
        <h1 class="h3 mb-8 text-balance">
          Call for Abstracts for Talks and Posters are Now Open
        </h1>
        <p class="max-w-[640px] mb-10 text-lg leading-relaxed text-white/85">
          Whether you're running Nextflow at scale, designing proteins, training models or
          building agents, we want to hear how your work is moving discovery and development
          forward. Tell us what you built, what it changed and what you learned along the way.
          Submit your abstract by Friday, February 5, 2027.
        </p>
        <Button arrow href="#form" className="w-fit">Deadline: February 5, 2027</Button>
      </div>

      <dl class="lg:col-span-5 border border-white/20 divide-y divide-white/20">
        {facts.map(([label, value]) => (
          <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 px-6 py-5">
            <dt class="monospace uppercase text-xs text-nextflow sm:w-24 shrink-0">{label}</dt>
            <dd class="font-display text-[1.5rem] md:text-[1.75rem] leading-tight">{value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* About + topic ideas */}
  <section class="border-t border-white/15">
    <div class="container-xl py-16 md:py-24 grid grid-cols-1 lg:grid-cols-12 gap-x-16 gap-y-12">
      <div class="lg:col-span-5 space-y-5">
        <h2 class="h6 md:text-[2.25rem] leading-tight">About the Nextflow Summit</h2>
        <p class="text-white/85 leading-relaxed">
          Nextflow Summit brings together the scientists, bioinformaticians, engineers, and
          leaders who turn biological data into discoveries. Join us in Boston for two days of
          talks, posters and networking.
        </p>
        <p class="text-white/85 leading-relaxed">
          For 2027 we are adding an additional theme to our usual Nextflow Summit topics:
          machine learning. Our field is undergoing a revolution and Nextflow sits right at the
          heart of it. We want to hear about your work!
        </p>
      </div>

      <div class="lg:col-span-7">
        <h2 class="h6 md:text-[2.25rem] leading-tight mb-6">
          Need inspiration? Here are some topic ideas
        </h2>
        <ul class="flex flex-wrap gap-2.5">
          {topics.map((t) => (
            <li class="flex items-center gap-2 border border-nextflow/60 px-3 py-2 text-sm">
              <span class="w-[5px] h-[5px] bg-nextflow shrink-0" aria-hidden="true"></span>
              {t}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* Talks / Posters: read before you start (white section, green cards) */}
  <FeatureBlocks boxes={formats} client:load />

  {/* The form, framed in its own band */}
  <section id="form" class="scroll-mt-20 py-16 md:py-24">
    <div class="container-xl">
      <div class="max-w-[1040px] mx-auto">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8">
          <h2 class="h5 leading-tight">Submit your abstract</h2>
          <p class="monospace uppercase text-xs text-nextflow">Deadline: February 5, 2027</p>
        </div>
        <div class="border border-nextflow p-2 md:p-3">
          <TypeformEmbed
            formId={CFA_TYPEFORM_ID}
            title={`Nextflow Summit Boston ${SUMMIT_YEAR}: Call for Abstracts`}
            client:only="react"
          />
        </div>
        <noscript>
          <p class="mt-4"><a class="underline" href={typeformUrl}>Open the abstract submission form</a></p>
        </noscript>
        <p class="text-xs mt-4 text-white/70">
          Having trouble viewing the form? <a class="underline" href={typeformUrl} target="_blank" rel="noopener noreferrer">Open it in a new window</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>
