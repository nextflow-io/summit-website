---
// All past events, built in code (no Sanity) until the 2027 rebrand.
import Layout from '@layouts/Base.astro';
import Meta from '@components/Meta/Meta.astro';
import FeatureBlocks from '@modules/FeatureBlocks';
import { PAST_EVENTS, toBox } from '@data/pastEvents';
---

<Layout>
  <Meta title="Past Events" description="Explore Nextflow Summit throughout the years" imgUrl={PAST_EVENTS[0].image} />
  <section class="container-xl pt-16 md:pt-24 pb-12">
    <h1 class="h2 mb-4">Past Events</h1>
    <p>Explore Nextflow Summit throughout the years</p>
  </section>
  <FeatureBlocks boxes={PAST_EVENTS.map(toBox)} client:load />
</Layout>
